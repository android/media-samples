    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <path android:pathData="M0,0h108v108h-108z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="18"
          android:startY="18"
          android:endX="90"
          android:endY="90">
        <item android:offset="0" android:color="#FF4B3AA8" />
        <item android:offset="1" android:color="#FF160E45" />
      </gradient>
    </aapt:attr>
  </path>
  <path android:pathData="M15.96,54.00a34,34 0,1 1,68 0a34,34 0,1 1,-68 0z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="radial"
          android:centerX="49.96"
          android:centerY="54.00"
          android:gradientRadius="34">
        <item android:offset="0" android:color="#29FFFFFF" />
        <item android:offset="1" android:color="#00FFFFFF" />
      </gradient>
    </aapt:attr>
  </path>
</vector>
